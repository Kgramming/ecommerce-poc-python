# --- PostgreSQL (orders = source of truth) ---
# NOTE: host port is 5433 (not the default 5432) because macOS dev machines
# often run a local Postgres on 5432, which would shadow Docker's mapping.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce

# --- MongoDB (product catalog) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ecommerce

# --- Elasticsearch (admin search) ---
ES_HOST=localhost
ES_PORT=9200
ES_INDEX=orders

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Sync strategy: dual_write | polling ---
SYNC_STRATEGY=dual_write
POLL_INTERVAL_SECONDS=15
